NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=

# Service role (serveur uniquement — JAMAIS exposé au client).
# Requis par le cron /api/crons/compute-spot-scores pour écrire dans spot_scores.
SUPABASE_SERVICE_ROLE_KEY=

# Secret protégeant les routes cron Vercel. Vercel envoie
# `Authorization: Bearer <CRON_SECRET>` sur les appels planifiés.
CRON_SECRET=
