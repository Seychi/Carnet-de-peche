NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=

# Service role (serveur uniquement — JAMAIS exposé au client).
# Requis par le cron /api/crons/compute-spot-scores pour écrire dans spot_scores.
SUPABASE_SERVICE_ROLE_KEY=

# Secret protégeant les routes cron Vercel. Vercel envoie
# `Authorization: Bearer <CRON_SECRET>` sur les appels planifiés.
CRON_SECRET=

# --- Stripe (sprint 9) ----------------------------------------------------
# LIVE : requis EN PRODUCTION uniquement (build Vercel échoue sinon).
# secret + webhook = serveur uniquement, JAMAIS exposés au client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_LOCAL_MONTHLY=
STRIPE_PRICE_LOCAL_ANNUAL=
STRIPE_PRICE_ITINERANT_MONTHLY=
STRIPE_PRICE_ITINERANT_ANNUAL=

# TEST : requis en dev + preview. Utilisés par Stripe CLI / Checkout test mode.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_PRICE_LOCAL_MONTHLY=
STRIPE_TEST_PRICE_LOCAL_ANNUAL=
STRIPE_TEST_PRICE_ITINERANT_MONTHLY=
STRIPE_TEST_PRICE_ITINERANT_ANNUAL=

# --- Emails transactionnels (sprint 11) -------------------------------------
# Requis en prod. Domaine d'envoi vérifié (SPF/DKIM) dans le dashboard Resend.
RESEND_API_KEY=

# --- Monitoring (sprint 11) --------------------------------------------------
# DSN public Sentry (pas un secret). Requis en prod.
NEXT_PUBLIC_SENTRY_DSN=
# Optionnels : upload des source maps au build (intégration Vercel<->Sentry)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Analytics PostHog (sprint 26 / D-F1) -----------------------------------
# Clé PROJET PostHog (publique, pas un secret) — requise en prod. Sans elle,
# l'instrumentation est entièrement no-op (aucune capture client ni serveur).
# Mesure d'audience anonymisée, sous consentement (bandeau cookies), hébergée UE.
NEXT_PUBLIC_POSTHOG_KEY=
# Hôte d'ingestion — UE par défaut. Ne PAS mettre l'hôte US (us.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Connecteurs MCP de Claude Code (PAS l'app Next.js) ---------------------
# ⚠️ Ces variables ne sont PAS lues par Next.js. Elles servent à l'interpolation
# ${VAR} dans .mcp.json. Claude Code les lit dans l'ENV du process, donc il faut
# les poser dans l'environnement Windows (persistant) :
#     setx GITHUB_PAT "github_pat_xxx"
#     setx STRIPE_MCP_KEY "rk_live_xxx"
# puis relancer le terminal + Claude Code. (supabase / vercel / sentry = OAuth, rien à mettre ici.)
#
# PAT GitHub fine-grained, scope repo Seychi/Carnet-de-peche (contents RO + issues + pull requests).
GITHUB_PAT=
# Clé Stripe RESTREINTE en lecture seule (Dashboard → Developers → API keys → Restricted).
# NE PAS réutiliser STRIPE_SECRET_KEY ici : on veut du read-only pour un compte LIVE.
STRIPE_MCP_KEY=
# Optionnel : Context7 marche sans clé. Une clé (context7.com/dashboard) augmente juste le rate-limit.
CONTEXT7_API_KEY=
